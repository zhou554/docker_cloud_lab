# 复制为 build-push-acr.yml 并配置 GitHub Secrets（个人版 ACR 示例，push 用公网域名）：
#   ACR_REGISTRY   crpi-6zjjswgvnui3es9q.cn-hangzhou.personal.cr.aliyuncs.com
#   ACR_NAMESPACE  zhou554_cloudlab
#   ACR_USERNAME   阿里云 ACR 登录用户名
#   ACR_PASSWORD   阿里云 ACR 登录密码
#
# 集群内 pull 使用 VPC 域名（与 k8s/*、monitoring/* 中 image 一致）：
#   crpi-6zjjswgvnui3es9q-vpc.cn-hangzhou.personal.cr.aliyuncs.com/zhou554_cloudlab/api:<tag>
#
# CI 只构建推送 api。推送后在 k3s master 更新 tag（任选其一）：
#   kubectl -n cloudlab set image deployment/api \
#     api=crpi-6zjjswgvnui3es9q-vpc.cn-hangzhou.personal.cr.aliyuncs.com/zhou554_cloudlab/api:<git-sha>
#   或修改 k8s/api-deployment.yaml 中 api 的 tag 后 git pull && kubectl apply -k k8s/

name: build-push-acr

on:
  push:
    branches: [main]
    paths:
      - "app/**"
      - "app/dockerfile"
      - ".github/workflows/build-push-acr.yml"

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Login ACR
        run: |
          echo "${{ secrets.ACR_PASSWORD }}" | docker login \
            "${{ secrets.ACR_REGISTRY }}" \
            -u "${{ secrets.ACR_USERNAME }}" --password-stdin

      - name: Build and push api
        env:
          REG: ${{ secrets.ACR_REGISTRY }}
          NS: ${{ secrets.ACR_NAMESPACE }}
          TAG: ${{ github.sha }}
        run: |
          IMAGE="${REG}/${NS}/api:${TAG}"
          docker build -t "$IMAGE" -f app/dockerfile ./app
          docker push "$IMAGE"
          echo "Pushed $IMAGE — 在 master 上对 deployment/api 执行 kubectl set image（见 workflow 顶部注释）"
