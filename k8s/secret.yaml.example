# 复制为 secret.yaml 后修改密码再 apply（secret.yaml 已 .gitignore，勿提交）。
#   copy k8s\secret.yaml.example k8s\secret.yaml
#
# 顺序（Namespace 必须先存在）：
#   kubectl apply -f k8s/namespace.yaml
#   kubectl apply -f k8s/secret.yaml
#   kubectl apply -k k8s/
#
apiVersion: v1
kind: Secret
metadata:
  name: cloudlab-secret
  namespace: cloudlab
type: Opaque
stringData:
  DB_PASSWORD: change_me
