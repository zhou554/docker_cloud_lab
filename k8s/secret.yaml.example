# 复制为 secret.yaml 后修改密码再 apply（secret.yaml 已 .gitignore，勿提交）。
#   copy k8s\secret.yaml.example k8s\secret.yaml
#
# 云上顺序见仓库 README 第 9 节，或：bash tools/cloud/deploy-business.sh
#
apiVersion: v1
kind: Secret
metadata:
  name: cloudlab-secret
  namespace: cloudlab
type: Opaque
stringData:
  DB_PASSWORD: change_me
